-   NULL-guarded by the CASE before the GREATEST. #}
+   NULL-guarded by the CASE before the GREATEST.
+
+   MISSING PARAMETER CELL (Task 2A). A lap whose (circuit, compound, season) has no
+   dim_compounds_season cell reaches this macro with wear_gradient and severity
+   NULL (the LEFT JOIN in int_compound_cliff_predicted). Its compound cost is
+   UNKNOWN, so the result is NULL. It used to COALESCE the gradient to 0.0 and
+   the severity to 0.0, which priced the lap as "never wears, never cliffs" -- a
+   valid-looking 0 s. Do not COALESCE either argument back. A cell that exists
+   but carries class_default / fallback values is a real cell and prices
+   normally; tell those apart through dim_compounds_season.is_measured and the
+   *_source columns, not through this macro. #}
 {% macro compound_cliff_wear_s(wear_gradient, severity, age, laps_past_cliff) -%}
 CASE
     WHEN {{ age }} IS NULL OR {{ laps_past_cliff }} IS NULL THEN NULL
+    WHEN {{ wear_gradient }} IS NULL OR {{ severity }} IS NULL THEN NULL
     ELSE LEAST(
-        COALESCE({{ wear_gradient }}, 0.0)
+        {{ wear_gradient }}
         * ({{ age }} - GREATEST(
             {{ laps_past_cliff }} - {{ var('compound_wear_hold_after_onset_laps') }},
             0.0))
