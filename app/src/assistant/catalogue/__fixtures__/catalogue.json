{
  "schema_version": 1,
  "seasons": [
    2018,
    2019,
    2020,
    2021,
    2022,
    2023,
    2024,
    2025
  ],
  "ops": {
    "eq": {
      "arity": "scalar"
    },
    "ne": {
      "arity": "scalar"
    },
    "lt": {
      "arity": "scalar"
    },
    "lte": {
      "arity": "scalar"
    },
    "gt": {
      "arity": "scalar"
    },
    "gte": {
      "arity": "scalar"
    },
    "in": {
      "arity": "list"
    },
    "between": {
      "arity": "pair"
    }
  },
  "aggregates": {
    "count": "COUNT(*) of the rows matched (use the view's count_name as col).",
    "avg": "Arithmetic mean of non-null values.",
    "median": "Median of non-null values.",
    "min": "Minimum.",
    "max": "Maximum.",
    "sum": "Sum; only on count-like measures."
  },
  "orders": [
    "value_asc",
    "value_desc",
    "group_asc"
  ],
  "limits": {
    "max_filters": 6,
    "max_in_values": 20,
    "max_group_by": 2,
    "max_limit": 25,
    "max_string_length": 64,
    "timeout_ms": 3000,
    "thin_n": 5,
    "decimals": 3
  },
  "views": [
    {
      "name": "qv_laps",
      "grain": "driver x lap",
      "note": "Green racing laps only: fct_lap_residuals is pre-filtered (no safety-car, VSC or red-flag laps). Observed lap times, not fuel- or tyre-corrected. Major outlier laps are excluded unless the request filters on is_major_outlier_lap.",
      "count_name": "laps",
      "required_filters": [
        "season"
      ],
      "group_by_requires": {
        "lap_number": [
          "race_id"
        ]
      },
      "default_filters": [
        {
          "col": "is_major_outlier_lap",
          "op": "eq",
          "val": false
        }
      ],
      "max_seasons": 2,
      "columns": [
        {
          "name": "season",
          "role": "dimension",
          "type": "integer",
          "ops": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "between"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Season (race_year)."
        },
        {
          "name": "race_id",
          "role": "dimension",
          "type": "string",
          "ops": [
            "eq",
            "ne",
            "in"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Race id, <season>_<round> (e.g. 2024_8). Use list_values(domain: race)."
        },
        {
          "name": "driver_id",
          "role": "dimension",
          "type": "string",
          "ops": [
            "eq",
            "ne",
            "in"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Three-letter driver code (e.g. LEC)."
        },
        {
          "name": "constructor_id",
          "role": "dimension",
          "type": "string",
          "ops": [
            "eq",
            "ne",
            "in"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Constructor id for that season."
        },
        {
          "name": "compound",
          "role": "dimension",
          "type": "string",
          "ops": [
            "eq",
            "ne",
            "in"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Tyre compound name (SOFT, MEDIUM, HARD, INTERMEDIATE, WET, and pre-2019 names)."
        },
        {
          "name": "stint_id",
          "role": "dimension",
          "type": "string",
          "ops": [
            "eq",
            "ne",
            "in"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Stint id."
        },
        {
          "name": "lap_number",
          "role": "dimension",
          "type": "integer",
          "ops": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "between"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Lap number in the race. Grouping by it requires a race_id filter."
        },
        {
          "name": "lap_in_stint",
          "role": "dimension",
          "type": "integer",
          "ops": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "between"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Lap number within the stint (1 = first lap of the stint)."
        },
        {
          "name": "age_in_stint",
          "role": "dimension",
          "type": "integer",
          "ops": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "between"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Tyre age in laps at that lap."
        },
        {
          "name": "is_major_outlier_lap",
          "role": "dimension",
          "type": "boolean",
          "ops": [
            "eq"
          ],
          "aggregates": [],
          "group_by": true,
          "description": "Major outlier lap flag (int_event_corrections). Excluded by default."
        },
        {
          "name": "lap_time_s",
          "role": "measure",
          "type": "number",
          "ops": [],
          "aggregates": [
            "avg",
            "median",
            "min",
            "max"
          ],
          "group_by": false,
          "description": "Observed lap time in seconds."
        }
      ],
      "partition_key": "season",
      "sub_partition_key": null
    },
