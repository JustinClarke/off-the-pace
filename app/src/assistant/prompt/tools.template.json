{
  "_comment": "Seven tool schemas (AD2). gen-tools.mjs replaces x-fill markers: views and card_kinds from the exported catalogue / index, bundles from prompt/playbook.json (AX-21; the property is dropped when that file is absent). Do not add column lists: columns come from list_values(domain:columns).",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_fact_cards",
        "description": "Fetch published fact cards (the only source of modelled numbers). Up to 3 scopes and 5 kinds per call, at most 10 cards returned.",
        "parameters": {
          "type": "object",
          "properties": {
            "scopes": {
              "type": "array", "maxItems": 3,
              "items": { "type": "object", "properties": { "season": { "type": "integer" }, "race_id": { "type": "string" }, "driver_id": { "type": "string" }, "constructor_id": { "type": "string" } } }
            },
            "kinds": { "type": "array", "maxItems": 5, "items": { "type": "string", "x-fill": "card_kinds" } },
            "bundle": { "type": "string", "x-fill": "bundles", "description": "A question type: returns its recipe of cards in one call." }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "query_data",
        "description": "Bounded query over an observed-data view. Never for modelled numbers.",
        "parameters": {
          "type": "object",
          "required": ["view"],
          "properties": {
            "view": { "type": "string", "x-fill": "views" },
            "filters": { "type": "array", "maxItems": 6, "items": { "type": "object", "required": ["col", "op", "val"], "properties": { "col": { "type": "string" }, "op": { "type": "string", "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "between"] }, "val": {} } } },
            "group_by": { "type": "array", "maxItems": 2, "items": { "type": "string" } },
            "aggregate": { "type": "object", "properties": { "fn": { "type": "string", "enum": ["count", "avg", "median", "min", "max", "sum"] }, "col": { "type": "string" } } },
            "order": { "type": "string", "enum": ["value_asc", "value_desc", "group_asc"] },
            "limit": { "type": "integer", "maximum": 25 }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_values",
        "description": "Look up exact codes (driver, constructor, race, circuit, season, compound, columns ...) from a name or alias.",
        "parameters": {
          "type": "object",
          "required": ["domain"],
          "properties": {
            "domain": { "type": "string", "enum": ["driver", "constructor", "race", "circuit", "season", "compound", "caution_status", "stint_end_cause", "card_kind", "page", "columns"] },
            "query": { "type": "string" },
            "season": { "type": "integer" },
            "view": { "type": "string", "x-fill": "views" },
            "limit": { "type": "integer", "maximum": 20 }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "compare_lap_times",
        "description": "Chart two drivers' lap times in one race. Returns a chart id, not the points.",
        "parameters": { "type": "object", "required": ["race_id", "driver_a", "driver_b"], "properties": { "race_id": { "type": "string" }, "driver_a": { "type": "string" }, "driver_b": { "type": "string" } } }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "make_chart",
        "description": "Chart the rows of an earlier query_data result.",
        "parameters": { "type": "object", "required": ["result_id"], "properties": { "result_id": { "type": "string" }, "kind": { "type": "string", "enum": ["line", "bar", "scatter"] } } }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "explain_page",
        "description": "Explain what a page of the app shows and how to read it.",
        "parameters": { "type": "object", "required": ["page"], "properties": { "page": { "type": "string" } } }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "navigate",
        "description": "Open a page of the app with a race, driver or season selected.",
        "parameters": { "type": "object", "required": ["route"], "properties": { "route": { "type": "string" }, "params": { "type": "object" } } }
      }
    }
  ]
}
