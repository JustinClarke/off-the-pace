[sqlfluff]
templater = dbt
dialect = duckdb
exclude_rules = L034, L036
# Disable file size limit to allow linting of large SQL files like
# int_constructor_deg_sensitivity.sql (22KB) and fct_cliff_prediction_features.sql (40KB)
large_file_skip_byte_limit = 0

[sqlfluff:templater:dbt]
project_dir = ./
# Use the project's checked-in profile (relative ../data/*.duckdb paths) and the
# ci target, matching every other dbt invocation. Without this, the dbt templater
# falls back to ~/.dbt/profiles.yml, whose absolute path may not resolve locally.
profiles_dir = profiles
profile = off_the_pace
target = ci

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:layout:type:comma]
line_position = trailing
