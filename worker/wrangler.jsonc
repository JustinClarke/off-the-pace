{
  // Preview environment only. Production is deliberately not defined here: deploying it is the owner's call.
  "name": "otp-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  "vars": {
    // Pause switch. Edit in the dashboard (no deploy) or POST /admin/pause.
    "AI_PAUSED": "false",
    // Comma-separated browser origins allowed to call the Worker.
    "ALLOWED_ORIGINS": "https://off-the-pace.web.app",
    // AD4-B / HD6: at or under the free allowance (10,000 neurons a day). Workers AI's own error also pauses.
    "DAILY_NEURON_CAP": "10000",
    // Questions per visitor per day (HD6), not model rounds.
    "VISITOR_DAILY_LIMIT": "3",
    // Cloudflare Turnstile public test site key lives in the app, not here.
    "TURNSTILE_ENABLED": "true"
  }
  // Secrets (owner sets with `wrangler secret put`; never in this file):
  //   TURNSTILE_SECRET, ADMIN_TOKEN, TICKET_SECRET (any long random string)
}
